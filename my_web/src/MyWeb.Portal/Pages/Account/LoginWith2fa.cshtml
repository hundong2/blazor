@page
@model MyWeb.Portal.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "2단계 인증";
}

<section class="auth-panel">
    <p class="eyebrow">TWO-FACTOR AUTHENTICATION</p>
    <h1>인증 코드 확인</h1>
    <p>Authenticator 앱에 표시된 6자리 코드를 입력하세요.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="RememberMe" type="hidden" />
        <label asp-for="Input.Code">인증 코드</label>
        <input asp-for="Input.Code" inputmode="numeric" autocomplete="one-time-code" />
        <span asp-validation-for="Input.Code" class="validation"></span>
        <label class="checkbox-row">
            <input asp-for="Input.RememberMachine" />
            이 브라우저를 신뢰
        </label>
        <button class="primary" type="submit">확인</button>
    </form>
</section>
