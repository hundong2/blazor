# This file documents environment-variable overrides. Copy to .env only for Docker Compose.
# ASP.NET Core reads variables from the process environment, not this file directly.

MYWEB_CONFIG_FILE=D:\MyWeb\appsettings.Local.json
MYWEB_Server__BindAddress=127.0.0.1
MYWEB_Server__Port=17831
MYWEB_MyWeb__PublicUrl=https://portal.example.com
MYWEB_MyWeb__OwnerEmail=owner@example.com

# Docker Compose-only values
OPEN_WEBUI_HOST_PORT=17832
OLLAMA_HOST_PORT=17836
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.5
