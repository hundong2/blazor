<Window x:Class="wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:wpf.ViewModels"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="JSON Editor - AvalonEdit (Real-time Highlight)"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        materialDesign:ColorZoneAssist.Mode="PrimaryDark">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <!-- Top AppBar / Menu -->
        <materialDesign:ColorZone Mode="PrimaryDark" DockPanel.Dock="Top" Padding="8">
            <DockPanel>
                <Menu DockPanel.Dock="Left">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Open" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Save _As" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="Format JSON" Command="{Binding FormatJsonCommand}" InputGestureText="Ctrl+Shift+F" />
                    </MenuItem>
                    <MenuItem Header="_Settings" />
                </Menu>
                <TextBlock DockPanel.Dock="Right"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding Title}"/>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Editor area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- AvalonEdit TextEditor -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <avalonedit:TextEditor x:Name="JsonEditor"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="JavaScript"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Background="White"
                                       Foreground="Black"
                                       LineNumbersForeground="Gray"/>
            </Border>

            <!-- Search/Highlight Controls -->
            <materialDesign:ColorZone Grid.Row="1" Mode="PrimaryMid" Padding="8">
                <DockPanel>
                    <TextBlock VerticalAlignment="Center" 
                               Text="Real-time Highlight:" 
                               Margin="0,0,8,0"
                               Foreground="White"/>
                    <TextBox Width="200" 
                             x:Name="HighlightBox"
                             materialDesign:HintAssist.Hint="Type to highlight instantly"
                             Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" 
                               Text="{Binding HighlightTerm, StringFormat='Current: &quot;{0}&quot;'}"
                               Margin="0,0,8,0"
                               Foreground="White"
                               FontStyle="Italic"/>
                    <Button Content="Clear Highlights" 
                            x:Name="ClearHighlightButton"
                            Margin="0,0,8,0"/>
                    <Button Content="Format JSON" 
                            Command="{Binding FormatJsonCommand}"
                            materialDesign:ButtonAssist.CornerRadius="3"/>
                </DockPanel>
            </materialDesign:ColorZone>
        </Grid>
    </DockPanel>
</Window>
